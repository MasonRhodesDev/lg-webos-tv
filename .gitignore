.env
tv-config.json

# ui-atlas: generated from a backup; contains LG's copyrighted files and the owner's screen
tools/ui-atlas/.local/
tools/ui-atlas/out/
tools/ui-atlas/**/facts.json
tools/ui-atlas/**/srcdoc.json
tools/ui-atlas/**/hbc_dom.html
