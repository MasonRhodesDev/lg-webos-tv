#!/usr/bin/env python3
"""Extract every PAK body out of a fully-decrypted EPK3 body.

Format (from openlgtv/epk2extract src/epk3.c and include/epk3.h, cross-
checked against B9 stock firmware):

  0x000 .. 0x100     outer signature
  0x100 .. 0x6D4     EPK_V3_NEW_HEADER_T + platformVersion + sdkVersion
  0x6D4 .. 0x7D4     packageInfo signature
  0x7D4 .. 0x7E0     PAK list header (list_size, count, pakInfoMagic)
  0x7E0 .. body_start   count x 324-byte PAK records
  body_start ..      concatenated segments, one per record. Each segment:
       [0x100 bytes per-segment signature]
       [4 bytes decrypted segment-index prefix (uint32 LE = global idx)]
       [segmentSize - 4 bytes of real partition data]
       [4 bytes undocumented inter-segment gap (upstream "extraSegmentSize")]

The decrypted region at each segment is exactly `segmentSize` bytes
starting at `seg_sig_start + 256`. The first 4 are the segment index
(`i` in the upstream extractEPK3 loop, i.e. the running counter across
all PAKs). The partition data is the remaining `segmentSize - 4` bytes.

Upstream writes `segmentSize` bytes starting at `dataPtr + 4`, which
includes 4 undecrypted bytes past the end of the AES window. Our
extractor writes `segmentSize - 4` bytes, i.e. only the real partition
data, since that matches on-device MTD contents.
"""
from __future__ import annotations
import argparse
import struct
import sys
from pathlib import Path

SIG_SIZE = 0x100
EPK_HEADER_OFFSET = 0x100
EPK_HEADER_LEN = 1460
PLATFORM_SDK_LEN = 32
PKGINFO_SIG_OFFSET = EPK_HEADER_OFFSET + EPK_HEADER_LEN + PLATFORM_SDK_LEN  # 0x6D4
PKGINFO_OFFSET = PKGINFO_SIG_OFFSET + SIG_SIZE  # 0x7D4
PAK_LIST_HDR_SIZE = 12
PAK_RECORD_SIZE = 324
EXTRA_SEGMENT_SIZE = 4


def parse_records(data: bytes):
    offs = PKGINFO_OFFSET
    list_size, count, magic = struct.unpack_from("<III", data, offs)
    recs = []
    base = offs + PAK_LIST_HDR_SIZE
    for i in range(count):
        p = base + i * PAK_RECORD_SIZE
        ptype = struct.unpack_from("<I", data, p)[0]
        pname = data[p + 8:p + 136].rstrip(b"\x00").decode("ascii", errors="replace")
        pver = data[p + 136:p + 232].rstrip(b"\x00").decode("ascii", errors="replace")
        psize = struct.unpack_from("<I", data, p + 296)[0]
        seg_is = struct.unpack_from("<I", data, p + 304)[0]
        seg_idx = struct.unpack_from("<I", data, p + 308)[0]
        seg_count = struct.unpack_from("<I", data, p + 312)[0]
        seg_size = struct.unpack_from("<I", data, p + 316)[0]
        recs.append({
            "index": i, "type": ptype, "name": pname, "version": pver,
            "packageSize": psize, "segmentSize": seg_size,
            "segmentIndex": seg_idx, "segmentCount": seg_count,
            "isSegmented": seg_is,
        })
    return recs, base + count * PAK_RECORD_SIZE


def extract(epk_path: Path, out_dir: Path, raw_prefix: bool) -> None:
    data = epk_path.read_bytes()
    recs, body_start = parse_records(data)
    print(f"body starts at {body_start:#x}; {len(recs)} records")
    out_dir.mkdir(parents=True, exist_ok=True)

    cursor = body_start
    global_i = 0
    for r in recs:
        segsz = r["segmentSize"]
        if segsz == 0 or segsz > 0x8000000 or cursor + SIG_SIZE + segsz > len(data) + EXTRA_SEGMENT_SIZE:
            print(f"  [{r['index']:>3}] {r['name']:<24} BOGUS segmentSize={segsz:#x} — stopping")
            break
        seg_sig_start = cursor
        decrypted_start = cursor + SIG_SIZE
        # First 4 bytes of the decrypted region are the global segment index.
        prefix = struct.unpack_from("<I", data, decrypted_start)[0]
        if prefix != global_i:
            print(f"  [{r['index']:>3}] WARNING prefix={prefix} != expected global index {global_i}")
        body_start_off = decrypted_start if raw_prefix else decrypted_start + EXTRA_SEGMENT_SIZE
        body_end_off = decrypted_start + segsz  # end of decrypted window
        if body_end_off > len(data):
            print(f"  [{r['index']:>3}] {r['name']:<24} OUT OF RANGE "
                  f"({body_start_off:#x}..{body_end_off:#x} > {len(data):#x})")
            break

        if r["isSegmented"] and r["segmentCount"] > 1:
            fname = f"{r['index']:03d}_{r['name']}_seg{r['segmentIndex']:03d}_of_{r['segmentCount']:03d}.bin"
        else:
            fname = f"{r['index']:03d}_{r['name']}.bin"
        out = out_dir / fname
        out.write_bytes(data[body_start_off:body_end_off])

        if r["isSegmented"] and r["segmentCount"] > 1:
            merged = out_dir / f"merged_{r['name']}.bin"
            with open(merged, "ab") as fp:
                fp.write(data[body_start_off:body_end_off])

        magic = data[body_start_off:body_start_off + 16].hex()
        actual_size = body_end_off - body_start_off
        print(f"  [{r['index']:>3}] {r['name']:<24} seg {r['segmentIndex']:>3}/{r['segmentCount']:<3} "
              f"prefix={prefix:>3} body@{body_start_off:#010x} +{actual_size:>10} "
              f"({actual_size:#x})  magic={magic[:16]}")

        cursor = decrypted_start + segsz + EXTRA_SEGMENT_SIZE
        global_i += 1


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("epk", type=Path, help="fully-decrypted EPK3 body")
    ap.add_argument("-o", "--out", type=Path, default=Path("paks"))
    ap.add_argument("--raw-prefix", action="store_true",
                    help="keep the 4-byte segment-index prefix in the extracted body "
                         "(upstream epk2extract writes it as a side-effect of mwrite(+4, segmentSize))")
    args = ap.parse_args()
    extract(args.epk, args.out, raw_prefix=args.raw_prefix)
    return 0


if __name__ == "__main__":
    sys.exit(main())
