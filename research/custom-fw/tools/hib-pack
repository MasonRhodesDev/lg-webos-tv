#!/usr/bin/env python3
"""Emit a B9 hib partition image driving lxboot's compType=3 (LZ4) resume path.

Layout, all fields little-endian, per b9-component-a1-hibformat.md Option B:

  Header (4 KiB at offset 0):
    0x0F20  u32  magic          = 0x03160326
    0x0F24  u32  compType       = 3                   # LZ4
    0x0F28  u32  payloadSize    = metaOff + 16        # body + meta table end
    0x0F2C  u32  compBlockCount = 1
    0x0F30  u32  metaOff        = 0x1000 + lz4_len    # partition-relative
                                  then 16-byte aligned so meta table is aligned
    0x0F38  u32  entryPC        = 0x30000000          # ELR_EL2 on ERET
    0x0F78  u32  depCount       = 0                   # skip FUN_0002466c

  Body (lz4 stream) at hib offset 0x1000.
    Raw LZ4 block (not frame-wrapped), produced by emit_lz4_literal_block below.

  Comp meta table at hib offset metaOff (one 16-byte record):
    +0x00 u32  start_pfn      = 0x30000              # dest = 0x30000000
    +0x04 u32  compblock_src  = 0                    # offset into stream
    +0x08 u32  flags/length   = 0                    # uncertain; see README
    +0x0C u32  compblock_size = len(lz4_stream)

  Trailer at hib offset ALIGN(payloadSize, 16), 0x2110 bytes:
    +0x0000 u32   magic       = 0xABF6178A
    +0x0004 u32   block_size  = hashed_region_size   # arbitrary when blk_cnt<2
    +0x0008 u32   block_count = 1
    +0x000C u32   reserved    = 0
    +0x0010..+0x200F  zero-pad (per-chunk table skipped for block_count=1)
    +0x2010..+0x202F  SHA-256 of body region [0x1000, ALIGN(payloadSize, 16))
    +0x2030..+0x210F  zero-pad

  Remainder of the 150 MiB partition is zero-padded.

Pure stdlib. Does not touch any device.
"""

from __future__ import annotations

import argparse
import hashlib
import struct
import sys
from pathlib import Path

HIB_SIZE = 150 * 1024 * 1024           # 0x9600000 (150 MiB)
PAGE = 0x1000

HDR_MAGIC_OFF        = 0x0F20
HDR_COMPTYPE_OFF     = 0x0F24
HDR_PAYLOADSIZE_OFF  = 0x0F28
HDR_BLOCKCOUNT_OFF   = 0x0F2C
HDR_METAOFF_OFF      = 0x0F30
HDR_ENTRY_OFF        = 0x0F38
HDR_DEPCOUNT_OFF     = 0x0F78

MAGIC                = 0x03160326
COMPTYPE_LZ4         = 3
ENTRY_PHYS           = 0x30000000
START_PFN            = ENTRY_PHYS >> 12      # 0x30000

TRAILER_MAGIC        = 0xABF6178A
TRAILER_SIZE         = 0x2110
TRAILER_SHA_OFF      = 0x2010                # single-chunk SHA slot


def emit_lz4_literal_block(data: bytes) -> bytes:
    """Produce a single-sequence LZ4 raw block that decodes to `data`.

    LZ4 block format (raw, not frame-wrapped):
      token        = (lit_len_tag << 4) | match_len_tag
      LSIC literal bytes (if lit_len_tag == 15)
      literal bytes
      [match offset + LSIC match bytes]       <-- omitted: end-of-block

    The last sequence of a block MUST be literal-only (no match). We emit the
    entire payload as that final sequence, which is spec-compliant and well
    inside what LZ4_decompress_safe accepts. `match_len_tag` goes in the low
    nibble as 0; it is never consulted because we never emit an offset.
    """
    out = bytearray()
    n = len(data)
    if n < 15:
        out.append((n << 4) | 0)
    else:
        out.append(0xF0)              # lit_len_tag = 15, match_len_tag = 0
        rem = n - 15
        while rem >= 255:
            out.append(255)
            rem -= 255
        out.append(rem)
    out.extend(data)
    return bytes(out)


def build_image(payload: bytes) -> tuple[bytes, dict]:
    if len(payload) > PAGE:
        raise SystemExit(
            f"payload is {len(payload)} bytes; must fit in one {PAGE}-byte page"
        )

    # Pad the payload to a full page so the decompressed block covers the
    # whole destination page and the entryPC range is unambiguous.
    page_payload = payload + b"\x00" * (PAGE - len(payload))
    lz4 = emit_lz4_literal_block(page_payload)

    # Body starts at 0x1000. Meta table placed immediately after the stream,
    # 16-byte aligned so the record offsets match.
    body_end = PAGE + len(lz4)
    meta_off = (body_end + 0xF) & ~0xF
    payload_size = meta_off + 16                  # per-record = 16 bytes
    trailer_off = (payload_size + 0xF) & ~0xF
    hashed_len = trailer_off - PAGE               # size the SHA covers

    if trailer_off + TRAILER_SIZE > HIB_SIZE:
        raise SystemExit("hib layout overflows 150 MiB")

    img = bytearray(HIB_SIZE)

    def wr_u32(off: int, val: int) -> None:
        struct.pack_into("<I", img, off, val & 0xFFFFFFFF)

    # Header
    wr_u32(HDR_MAGIC_OFF,       MAGIC)
    wr_u32(HDR_COMPTYPE_OFF,    COMPTYPE_LZ4)
    wr_u32(HDR_PAYLOADSIZE_OFF, payload_size)
    wr_u32(HDR_BLOCKCOUNT_OFF,  1)
    wr_u32(HDR_METAOFF_OFF,     meta_off)
    wr_u32(HDR_ENTRY_OFF,       ENTRY_PHYS)
    wr_u32(HDR_DEPCOUNT_OFF,    0)

    # Body: lz4 stream at offset 0x1000.
    img[PAGE:PAGE + len(lz4)] = lz4

    # Comp meta table (single 16-byte record)
    wr_u32(meta_off + 0x00, START_PFN)
    wr_u32(meta_off + 0x04, 0)                    # compblock_src
    wr_u32(meta_off + 0x08, 0)                    # flags/length (see risks)
    wr_u32(meta_off + 0x0C, len(lz4))             # compblock_size

    # Trailer
    wr_u32(trailer_off + 0x0, TRAILER_MAGIC)
    wr_u32(trailer_off + 0x4, hashed_len)         # block_size (ignored on blk_cnt<2)
    wr_u32(trailer_off + 0x8, 1)                  # block_count
    wr_u32(trailer_off + 0xC, 0)                  # reserved

    # SHA-256 of body region [0x1000, trailer_off)
    digest = hashlib.sha256(bytes(img[PAGE:trailer_off])).digest()
    img[trailer_off + TRAILER_SHA_OFF :
        trailer_off + TRAILER_SHA_OFF + 32] = digest

    info = {
        "magic":          MAGIC,
        "compType":       COMPTYPE_LZ4,
        "payloadSize":    payload_size,
        "compBlockCount": 1,
        "metaOff":        meta_off,
        "entryPC":        ENTRY_PHYS,
        "depCount":       0,
        "lz4_len":        len(lz4),
        "trailer_off":    trailer_off,
        "hashed_len":     hashed_len,
        "body_sha256":    digest.hex(),
        "start_pfn":      START_PFN,
    }
    return bytes(img), info


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--payload", required=True, type=Path,
                    help="path to raw payload.bin (<= 4096 bytes)")
    ap.add_argument("--out", required=True, type=Path,
                    help="where to write the 150 MiB hib image")
    args = ap.parse_args()

    payload = args.payload.read_bytes()
    image, info = build_image(payload)
    args.out.write_bytes(image)

    print(f"wrote {args.out} ({len(image)} bytes)")
    print(f"  magic           @0x{HDR_MAGIC_OFF:04x} = 0x{info['magic']:08x}")
    print(f"  compType        @0x{HDR_COMPTYPE_OFF:04x} = {info['compType']}")
    print(f"  payloadSize     @0x{HDR_PAYLOADSIZE_OFF:04x} = 0x{info['payloadSize']:x}")
    print(f"  compBlockCount  @0x{HDR_BLOCKCOUNT_OFF:04x} = {info['compBlockCount']}")
    print(f"  metaOff         @0x{HDR_METAOFF_OFF:04x} = 0x{info['metaOff']:x}")
    print(f"  entryPC         @0x{HDR_ENTRY_OFF:04x} = 0x{info['entryPC']:08x}")
    print(f"  depCount        @0x{HDR_DEPCOUNT_OFF:04x} = 0")
    print(f"  lz4 stream len  = {info['lz4_len']} bytes @ 0x{PAGE:04x}")
    print(f"  meta[0].start_pfn       = 0x{info['start_pfn']:x} (=> phys 0x{info['start_pfn']<<12:08x})")
    print(f"  meta[0].compblock_src   = 0")
    print(f"  meta[0].flags           = 0  (uncertain; see README)")
    print(f"  meta[0].compblock_size  = 0x{info['lz4_len']:x}")
    print(f"  trailer_off     = 0x{info['trailer_off']:x}")
    print(f"  hashed region   = [0x{PAGE:x}, 0x{info['trailer_off']:x}) ({info['hashed_len']} bytes)")
    print(f"  body SHA-256    = {info['body_sha256']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
