{
 "id": "safety",
 "meaning": "Parental locks (needs the PIN)",
 "lgTarget": "parentalControls",
 "pages": [
  {
   "id": "Safety",
   "meaning": "Safety top page",
   "lgPath": [
    "Safety"
   ],
   "items": [
    {
     "id": "parentalControl",
     "meaning": "Locks on or off",
     "tier": 2,
     "api": {
      "service": "com.webos.settingsservice",
      "read": "getSystemSettings",
      "write": "setSystemSettings",
      "category": "lock",
      "keys": [
       "parentalControl"
      ]
     },
     "type": "switch",
     "domain": {
      "values": [
       true,
       false
      ]
     },
     "domainSource": "description.json, default variant",
     "confirm": "the PIN (our PIN prompt, checked against lock.systemPin)",
     "notes": "every Safety page is behind the PIN prompt"
    },
    {
     "id": "ratingLocks",
     "meaning": "Block programmes by rating",
     "tier": 2,
     "type": "page",
     "opens": "RatingLocks",
     "api": {
      "none": "navigation only"
     }
    },
    {
     "id": "applicationLocks",
     "meaning": "Lock apps",
     "tier": 2,
     "type": "page",
     "opens": "ApplicationLocks",
     "api": {
      "none": "navigation only"
     }
    },
    {
     "id": "inputLocks",
     "meaning": "Lock inputs",
     "tier": 3,
     "type": "page",
     "opens": "InputLocks",
     "api": {
      "none": "navigation only"
     }
    },
    {
     "id": "changePin",
     "meaning": "Change the PIN",
     "tier": 2,
     "api": {
      "service": "com.webos.settingsservice",
      "read": "getSystemSettings",
      "write": "setSystemSettings",
      "category": "lock",
      "keys": [
       "systemPin"
      ]
     },
     "type": "form",
     "notes": "LG's Settings reads lock.systemPin with getSystemSettings and writes it with setSystemSettings {category: \"lock\", settings: {systemPin, initialPinCode: false}} (its master-password reset, main.js); LG's own prompt (com.webos.notification/createPincodePrompt {promptType: \"set_match\"}) is how LG asks for it elsewhere. We ask for the PIN with our own prompt."
    },
    {
     "id": "systemPin",
     "meaning": "The PIN the locks ask for (four digits)",
     "tier": 3,
     "api": {
      "service": "com.webos.settingsservice",
      "read": "getSystemSettings",
      "write": "setSystemSettings",
      "category": "lock",
      "keys": [
       "systemPin"
      ]
     },
     "type": "info",
     "domain": {
      "runtime": true
     },
     "notes": "never shown; read to check an entered PIN. Default 0000 (1234 in FRA and NOR, LG's reset). Whether our bus identity may read it is a TV check."
    }
   ],
   "visibleWhen": "after PIN prompt success"
  },
