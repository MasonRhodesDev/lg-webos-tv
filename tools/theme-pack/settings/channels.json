    {
     "id": "channelTuning",
     "meaning": "Scan for channels (auto tuning)",
     "tier": 2,
     "api": {
      "service": "com.webos.applicationManager",
      "method": "launch",
      "params": {
       "id": "com.webos.app.channelsetting"
      }
     },
     "type": "action",
     "notes": "LG Settings hands tuning to a separate app; our Settings can launch it as is",
     "unknown": "exact app id/params not extracted offline; channelsetting is in localKeyWhiteList of appLaunch.js"
