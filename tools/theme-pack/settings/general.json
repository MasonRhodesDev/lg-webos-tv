   "lgPath": [
    "General",
    "Timers"
   ],
   "items": [
    {
     "id": "sleepTimer",
     "meaning": "Turn the TV off after a set time",
     "tier": 1,
     "api": {
      "service": "com.webos.service.tv.time",
      "read": "getSleepTimeInfo",
      "subscribe": true,
      "write": "setSleepTimeInfo",
      "param": "sleepTimeMinute"
     },
     "type": "enum",
     "domain": {
      "values": [
       "off",
       "10",
       "20",
       "30",
       "60",
       "90",
       "120",
       "180",
       "240"
      ],
      "unit": "min"
     },
     "notes": "response has sleepTimeMinute and sleepTimeSecond (remaining); LG maps the remaining time onto the list. QuickSettings uses the same service (ServiceModel/TimerServiceModel.qml); tv.time does not answer \"subscribed\": true"
    },
    {
     "id": "timerPowerOn",
     "meaning": "Turn on at a set time",
     "tier": 3,
     "type": "page",
     "opens": "TimerPowerOn",
