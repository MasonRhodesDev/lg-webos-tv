#!/bin/sh
# theme-pack boot hook (Homebrew Channel init.d). Re-applies the Look setup after every boot. Each step is guarded:
# anything missing or mismatched leaves that part of the TV stock.
# Boot hooks run with a reduced PATH; ls-control lives in /usr/sbin.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH
LOG=/tmp/themepack.log
# luna-send reads stdin when it is open, which stalls it when this runs over ssh; detach it.
exec </dev/null >>"$LOG" 2>&1
echo "=== $(date)"
# /tmp is gone after a cold boot; what each boot did with the layer also goes to a log that stays, with the uptime
# (the clock can be years out until it is set). own-layer.sh writes its outcome there too.
PLOG=/var/lib/webosbrew/themepack-boot.log
note() {
  echo "$*"
  [ -f $PLOG ] && [ $(wc -c < $PLOG) -gt 32768 ] && mv -f $PLOG $PLOG.old
  echo "up $(cut -d' ' -f1 /proc/uptime) hook $*" >> $PLOG
}

ROOT=/media/developer/themepack
APP=/usr/palm/applications/com.palm.app.settings
STUB=$ROOT/settings-stub
PKG=dev.themepack.look
SVC=$PKG.service

# 0. The clock. The TV keeps no time while it is off: every boot starts it at the same moment years back, and there it
# stays unless the network or a broadcast sets it. So this boot starts it from the best time it can get: a time
# server's, when install-boot.sh was given one (any web server the TV can reach: the Date line of its answer is the
# time), or else the last time the Look service wrote down, which is late by however long the TV was off but on
# about the right day. Done first, because the steps below wait on the clock.
KEPT=/media/developer/apps/usr/palm/services/$SVC/data/clock
SERVER=$ROOT/time-url
# What the time server says, in seconds since 1970; nothing if it does not answer. -k: a certificate is not valid
# yet by a clock that is years back.
server_time() {
  d=$(curl -skI -m 4 "$(cat $SERVER)" | tr -d '\r' | sed -n 's/^[Dd]ate: *//p' | head -1)
  [ -n "$d" ] && date -u -D '%a, %d %b %Y %H:%M:%S' -d "$d" +%s 2>/dev/null
}
set_clock() {
  luna-send -n 1 -w 5000 luna://com.palm.systemservice/time/setSystemTime "{\"utc\":$1}" | grep -q '"returnValue": *true'
}
asked=0
now=$(date +%s)
if [ -s $SERVER ] && t=$(server_time) && [ -n "$t" ]; then
  asked=1
  if [ $((t - now)) -gt 1 ] || [ $((now - t)) -gt 1 ]; then
    set_clock "$t" && echo "clock set from the time server: $(date)" || echo "clock not set (the time server answered, the TV refused)"
  else
    echo "clock agrees with the time server"
  fi
elif [ -s $KEPT ] && t=$(cat $KEPT) && [ "$t" -gt "$now" ] 2>/dev/null; then
  set_clock "$t" && echo "clock started from the last time kept: $(date)" || echo "clock not set (the TV refused the last time kept)"
else
  echo "clock left as it is"
fi

# 1. The bus resumes from the boot snapshot without the Look service's permissions.
# Its methods are public, and our layer calls as com.webos.surfacemanager.wedge, which belongs to no group until it is
# granted one; without that the service drops its calls unanswered. A client takes its groups when it connects, and
# the layer connects under that name only when step 2 loads it.
if [ -d /media/developer/apps/usr/palm/services/$SVC ]; then
  sh /media/developer/apps/usr/palm/services/$SVC/permissions.sh && echo "service permissions set"
  timeout -t 60 ls-control scan-services >/dev/null && echo "bus rescanned"
else
  echo "Look service not installed; skipping permissions"
fi

# 2. Our UI layer, loaded into the running compositor. Nothing restarts and the screen never blanks, so it runs in
# every boot at once, whether the TV booted in the background (Quick Start+) or in front of someone. Run again in
# the same boot, it puts a new layer in place of the loaded one.
layer=0
t0=$(date -u +%Y-%m-%dT%H:%M:%S)
if [ -f "$ROOT/layer/own-layer.sh" ]; then
  sh "$ROOT/layer/own-layer.sh" apply && layer=1
  [ $layer = 1 ] && echo "UI layer loaded (see /tmp/own-layer.log)" || echo "UI layer did not load (see /tmp/own-layer.log)"
else
  echo "compositor left stock (no layer installed)"
fi

# 3. The Settings stub over LG's Settings app, so the Home screen's Settings tile and LG's deep links open our
# Settings. Only once our layer is running, the Look service is installed and our Settings host has said it is live
# (parts/Settings.qml reports ready "settings: host ready"): the stub hands every launch to them, so without them
# Settings would open nothing, and LG's app stays. Report times are UTC ISO strings, so they compare as text.
settings_ready() {
  last=$(luna-send -n 1 -w 5000 luna://$SVC/getReports '{}' | grep -o '"at":"[^"]*","from":"ui","kind":"ready","text":"settings: host ready"' | tail -1 | cut -d'"' -f4)
  [ -n "$last" ] && [ "$last" \> "$t0" ]
}
host=0
if [ $layer = 1 ]; then
  i=0
  while [ $i -lt 30 ]; do settings_ready && { host=1; break; }; sleep 1; i=$((i + 1)); done
fi
if mount | grep -q " $APP "; then
  echo "settings already mounted"
elif ! grep -q '"vendor": "theme-pack"' "$STUB/appinfo.json" 2>/dev/null; then
  echo "settings left stock (no stub installed)"
elif [ $layer != 1 ] || [ ! -d /media/developer/apps/usr/palm/services/$SVC ]; then
  echo "settings left stock (the stub needs our layer and the Look service)"
elif [ $host != 1 ]; then
  echo "settings left stock (our Settings host never reported ready)"
else
  # SAM may hold the stock app's description from before the mount, whose localised entries name index.<locale>.html;
  # every such name serves the stub.
  for f in "$APP"/index*.html; do
    [ -f "$f" ] || continue
    n=$(basename "$f")
    [ -e "$STUB/$n" ] || ln -s index.html "$STUB/$n"
  done
  # A prerendered stock instance would keep answering launches. It is hidden, so closing it shows nothing.
  if luna-send -n 1 -w 10000 luna://com.webos.applicationManager/running '{}' | grep -q '"com.palm.app.settings"'; then
    luna-send -n 1 -w 5000 luna://com.webos.applicationManager/closeByAppId '{"id":"com.palm.app.settings"}' >/dev/null &&
      echo "resident stock settings closed"
  fi
  mount --bind "$STUB" "$APP" && echo "settings stub mounted"
fi

# The network can come up after this hook has run: a time server that did not answer is asked for two minutes more.
if [ -s $SERVER ] && [ $asked = 0 ]; then
  (
    i=0
    while [ $i -lt 24 ]; do
      sleep 5
      if t=$(server_time) && [ -n "$t" ]; then
        set_clock "$t" && echo "clock set from the time server, after the hook: $(date)"
        break
      fi
      i=$((i + 1))
    done
  ) &
fi

state=$(luna-send -n 1 -w 5000 luna://com.webos.service.tvpower/power/getPowerState '{}' | sed -n 's/.*"state": *"\([^"]*\)".*/\1/p')
note "boot hook ran; power state: ${state:-unknown}; layer $([ $layer = 1 ] && echo loaded || echo not loaded)"
