#!/bin/sh
# theme-pack boot hook (Homebrew Channel init.d). Re-applies the Look setup after every boot. Each step is guarded:
# anything missing or mismatched leaves that part of the TV stock.
# Boot hooks run with a reduced PATH; ls-control lives in /usr/sbin.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:$PATH
LOG=/tmp/themepack.log
# luna-send reads stdin when it is open, which stalls it when this runs over ssh; detach it.
exec </dev/null >>"$LOG" 2>&1
echo "=== $(date)"

ROOT=/media/developer/themepack
APP=/usr/palm/applications/com.palm.app.settings
STUB=$ROOT/settings-stub
PKG=dev.themepack.look
SVC=$PKG.service

# 1. The bus resumes from the boot snapshot without the Look service's permissions.
# Its methods are public, and the compositor's QML calls as com.webos.surfacemanager.systemui, which belongs to no
# group until it is granted one; without that the service drops its calls unanswered.
if [ -d /media/developer/apps/usr/palm/services/$SVC ]; then
  sh /media/developer/apps/usr/palm/services/$SVC/permissions.sh && echo "service permissions set"
  timeout -t 60 ls-control scan-services >/dev/null && echo "bus rescanned"
else
  echo "Look service not installed; skipping permissions"
fi

# 2. Our UI layer in the compositor. A client takes its bus groups when it connects, so the restart also picks up
# step 1.
layer=0
if [ -f "$ROOT/layer/own-layer.sh" ]; then
  sh "$ROOT/layer/own-layer.sh" apply && layer=1 && echo "UI layer started (see /tmp/own-layer.log)"
  [ $layer = 1 ] || echo "UI layer did not load (see /tmp/own-layer.log)"
else
  echo "compositor left stock (no layer installed)"
fi

# 3. The Settings stub over LG's Settings app, so the Home screen's Settings tile and LG's deep links open our
# Settings. Only once our layer is running and the Look service is installed: the stub hands every launch to them,
# so without them Settings would open nothing, and LG's app stays.
if mount | grep -q " $APP "; then
  echo "settings already mounted"
elif ! grep -q '"vendor": "theme-pack"' "$STUB/appinfo.json" 2>/dev/null; then
  echo "settings left stock (no stub installed)"
elif [ $layer != 1 ] || [ ! -d /media/developer/apps/usr/palm/services/$SVC ]; then
  echo "settings left stock (the stub needs our layer and the Look service)"
else
  # SAM may hold the stock app's description from before the mount, whose localised entries name index.<locale>.html;
  # every such name serves the stub.
  for f in "$APP"/index*.html; do
    [ -f "$f" ] || continue
    n=$(basename "$f")
    [ -e "$STUB/$n" ] || ln -s index.html "$STUB/$n"
  done
  # A prerendered stock instance would keep answering launches. It is hidden, so closing it shows nothing.
  if luna-send -n 1 -w 10000 luna://com.webos.applicationManager/running '{}' | grep -q '"com.palm.app.settings"'; then
    luna-send -n 1 -w 5000 luna://com.webos.applicationManager/closeByAppId '{"id":"com.palm.app.settings"}' >/dev/null &&
      echo "resident stock settings closed"
  fi
  mount --bind "$STUB" "$APP" && echo "settings stub mounted"
fi
